# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Test and coverage outputs
coverage/
.stryker-tmp/
reports/
!apps/*/src/reports/
!apps/*/src/reports/**

# Environment files
.env
.env.*
!.env.example

# Editor and OS files
.DS_Store
.vscode/
*.local

# pnpm
.pnpm-debug.log*

# husky internal helper, regenerated by the `prepare` script on install
.husky/_

# TypeScript incremental compilation cache
*.tsbuildinfo

# Generated e2e-only artifact: the sandboxed invoice processor needs a compiled
# .js sibling next to its .ts source (BullMQ resolves it relative to
# import.meta.url, which ts-jest points at src/ instead of dist/); staged by
# `pnpm --filter api test:e2e` right before the suite runs, never committed.
apps/api/src/workers/invoice.sandboxed.js

# Claude Code local state: settings.local.json is covered by *.local; the
# worktrees dir holds machine-specific symlinks and must never be committed.
# launch.json IS committed - it defines the shared preview servers.
.claude/worktrees/
