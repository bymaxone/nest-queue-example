# Copy to .env and adjust as needed. Apps load this via Node's --env-file; dotenv is banned.

# apps/api
PORT=3080
# API port
REDIS_URL=redis://localhost:6379/0
# Mode B url: the default Redis connection string
QUEUE_CONNECTION_STYLE=url
# Mode B connection shape: "url" or "options"
QUEUE_CONNECTION_MODE=own
# Connection ownership: "own" (Mode B) or "shared" (Mode A, app-owned ioredis client)
QUEUE_PREFIX=nqex
# Redis key prefix for every queue this example registers
QUEUE_DRAIN_TIMEOUT_MS=30000
# Shutdown drain budget in milliseconds
QUEUE_DRAIN_ON_SHUTDOWN=false
# Dev-only: drain the queue on graceful shutdown
QUEUE_OTEL=false
# Enable bullmq-otel telemetry span creation
WEBHOOK_FAILURES=2
# Number of injected failures before the webhook processor demo succeeds
REMINDER_DELAY_MS=60000
# Delay (ms) applied to a per-order reminder email so it lands in the delayed set
WEB_ORIGIN=http://localhost:3000
# Allowed CORS origin for the dashboard

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3080
# Base URL the dashboard uses to call the API
