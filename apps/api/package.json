{
  "name": "@nest-queue-example/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest build && node --env-file-if-exists=.env --watch dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --config jest.config.cjs --coverage",
    "pretest:e2e": "nest build && node scripts/prepare-sandboxed-artifact.mjs",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' node scripts/run-e2e.mjs",
    "mutation": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' stryker run"
  },
  "dependencies": {
    "@bymax-one/nest-queue": "file:../../../nest-queue",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bullmq": "^6.3.2",
    "bullmq-otel": "^2.0.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  }
}
