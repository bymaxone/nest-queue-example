{
  "name": "@nest-queue-example/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest build && node --env-file-if-exists=.env --watch dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --config jest.config.cjs --coverage",
    "pretest:e2e": "nest build && node scripts/prepare-sandboxed-artifact.mjs",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' node scripts/run-e2e.mjs",
    "mutation": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' stryker run"
  },
  "dependencies": {
    "@bymax-one/nest-queue": "file:../../../nest-queue",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.16.0",
    "bullmq-otel": "^1.3.1",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.3"
  }
}
