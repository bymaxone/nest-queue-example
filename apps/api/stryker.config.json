{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "jest",
  "plugins": ["@stryker-mutator/jest-runner"],
  "jest": {
    "projectType": "custom",
    "configFile": "jest.stryker.config.cjs",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 20000,
  "ignoreStatic": true,
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.module.ts",
    "!src/**/*.types.ts",
    "!src/**/*.d.ts",
    "!src/**/index.ts",
    "!src/main.ts"
  ],
  "thresholds": { "high": 99, "low": 95, "break": 95 },
  "concurrency": 2,
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation/api.json" }
}
